# ---- Core ----
# Use a full SQLAlchemy URL (psycopg3). Example for docker-compose:
# postgresql+psycopg://bakliz:bakliz@postgres:5432/bakliz
DATABASE_URL=

# Backend auth (UI + admin APIs)
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- Linkup (required for live sourcing/enrichment) ----
LINKUP_API_KEY=
# If Zeliq enrichment fails to find an email, BAKLIZ will re-query Linkup for more contacts up to this limit.
LINKUP_CONTACT_SEARCH_ATTEMPTS_PER_COMPANY=3

# ---- Optional: Zeliq (email enrichment) ----
# Note: Zeliq enrich endpoints are async and require a public callback URL.
EMAIL_ENRICH_PROVIDER=linkup
ZELIQ_API_KEY=
ZELIQ_CALLBACK_BASE_URL=
ZELIQ_WEBHOOK_SECRET=
ZELIQ_WAIT_SECONDS=0

# ---- Microsoft Graph (optional; required for live draft creation) ----
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=
GRAPH_AUTH_MODE=device_code
# Path inside backend container/host where MSAL token cache is stored.
GRAPH_TOKEN_CACHE_PATH=/data/msal_token_cache.bin

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000

# ---- Optional ----
TZ=UTC
# Force demo mode even if LINKUP_API_KEY is set.
BAKLIZ_DEMO_MODE=false
